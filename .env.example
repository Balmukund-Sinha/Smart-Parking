# Optional durable state for Vercel hybrid mode (recommended).
# Create a free Upstash Redis database and copy its REST credentials here or
# into Vercel Project Settings > Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hybrid live data controls.
SMARTPARK_LIVE_WEATHER=true
SMARTPARK_LIVE_LOCATIONS=true
SMARTPARK_WEATHER_TTL_SECONDS=600
SMARTPARK_OSM_TTL_SECONDS=86400

# Local-only bridge: operator observations are also published to Kafka.
# Vercel automatically disables this persistent-broker bridge.
SMARTPARK_KAFKA_BRIDGE=true
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=parking-events
